# Database connection (e.g., local Docker Postgres container or hosted DB)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/nebula_nexus?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/nebula_nexus?schema=public"

# NextAuth Secret (generate one using: openssl rand -base64 32)
AUTH_SECRET="your_auth_secret_key_here"
NEXTAUTH_SECRET="your_auth_secret_key_here"
